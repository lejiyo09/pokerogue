{
  // Cloudflare deploy config for this project's static build output.
  // No "main" worker script is set - this deploys dist/ as static assets
  // only (equivalent to a classic Cloudflare Pages / Netlify static site),
  // with no Vite plugin or Workers runtime involved.
  "name": "pokerogue",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
